{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sreon",
  "version": "1.1.0",
  "identifier": "com.sreon.browser",
  "build": { "frontendDist": "../src-tauri/ui" },
  "app": {
    "windows": [{ "title": "Sreon", "width": 1280, "height": 820, "minWidth": 800, "minHeight": 560 }],
    "security": { "csp": null },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "nsis"],
    "category": "Internet",
    "shortDescription": "A private browser",
    "longDescription": "Sreon browser with a built-in SPRFST engine.",
    "resources": {
      "../engine/": "engine/",
      "../std/": "std/",
      "../rules/": "rules/",
      "../guidebook/": "guidebook/",
      "../examples/": "examples/",
      "../ui/": "ui/",
      "../assets/splash.html": "splash.html",
      "../build/bin/": "bin/"
    },
    "linux": { "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"] } },
    "windows": { "nsis": { "displayLanguageSelector": false, "languages": ["English"] } }
  }
}

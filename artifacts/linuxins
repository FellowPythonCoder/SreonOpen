#!/bin/sh
# Self-contained Sreon Linux installer for Debian/Ubuntu amd64 and arm64.
set -eu
arch=$(dpkg --print-architecture 2>/dev/null || true)
case "$arch" in
  amd64) begin=__AMD64_PAYLOAD__; end=__AMD64_END__ ;;
  arm64) begin=__ARM64_PAYLOAD__; end=__ARM64_END__ ;;
  *) echo "Unsupported Linux architecture: ${arch:-unknown}. Supported: amd64, arm64." >&2; exit 1 ;;
esac
work=$(mktemp -d "${TMPDIR:-/tmp}/sreon-linuxins.XXXXXX")
cleanup() { rm -rf "$work"; }
trap cleanup EXIT HUP INT TERM
sed -n "/^${begin}$/,/^${end}$/p" "$0" | sed '1d;$d' | base64 -d > "$work/sreon.deb"
if [ "$(id -u)" -eq 0 ]; then
  dpkg -i "$work/sreon.deb" || apt-get install -f -y
  apt-get install -f -y
else
  sudo dpkg -i "$work/sreon.deb" || sudo apt-get install -f -y
  sudo apt-get install -f -y
fi
cat <<'MSG'
Sreon graphical interface installed.
It opens the Sreon internal interface in Chromium app mode when Chromium is
available, otherwise in your default browser. External websites are handed
off to your system browser. This is not yet a full standalone browser shell.
MSG
if command -v sreon-gui >/dev/null 2>&1; then
  nohup sreon-gui >/dev/null 2>&1 </dev/null &
else
  echo "Install completed, but the GUI launcher was not found." >&2
  exit 1
fi


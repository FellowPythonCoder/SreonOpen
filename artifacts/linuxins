#!/bin/sh
# Sreon Linux engine installer. Self-contained amd64/arm64 Debian installer.
set -eu

arch=$(dpkg --print-architecture 2>/dev/null || true)
case "$arch" in
  amd64) marker=AMD64 ;;
  arm64) marker=ARM64 ;;
  *) echo "Unsupported Linux architecture: ${arch:-unknown}. Supported: amd64, arm64." >&2; exit 1 ;;
esac

work=$(mktemp -d "${TMPDIR:-/tmp}/sreon-linuxins.XXXXXX")
cleanup() { rm -rf "$work"; }
trap cleanup EXIT HUP INT TERM
case "$marker" in
  AMD64) payload=$(sed -n '/^__AMD64_PAYLOAD__$/,/^__AMD64_END__$/p' "$0" | sed '1d;$d') ;;
  ARM64) payload=$(sed -n '/^__ARM64_PAYLOAD__$/,/^__ARM64_END__$/p' "$0" | sed '1d;$d') ;;
esac
printf '%s' "$payload" | base64 -d > "$work/sreon.deb"

if [ "$(id -u)" -eq 0 ]; then
  dpkg -i "$work/sreon.deb"
else
  sudo dpkg -i "$work/sreon.deb"
fi

cat <<'MSG'
Sreon engine installed successfully.
This package contains the SPRFST command-line engine and resources only;
it does not install the graphical Sreon browser application.
MSG

